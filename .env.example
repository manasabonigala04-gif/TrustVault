NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-a-random-value-at-least-32-characters
DATABASE_PATH=data/trustvault.sqlite
UPLOAD_DIR=uploads
COOKIE_SECURE=false
TRUST_PROXY=false

# Used only by npm run setup:admin. Remove these after creating the first admin.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=TrustVault Administrator
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters